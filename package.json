{
  "name": "uncut",
  "description": "Uncut, an open-source, AI-first video editor for launch videos and devrel clips (macOS).",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm typecheck && node --test \"test/**/*.test.ts\"",
    "test:fast": "pnpm typecheck && node --test \"test/!(app)/**/*.test.ts\"",
    "test:app": "node --test \"test/app/**/*.test.ts\"",
    "test:file": "node --test",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core && tsc -p packages/contracts && tsc -p packages/plugin-sdk && tsc -p apps/server && tsc -p apps/desktop && tsc -p apps/web && tsc -p test",
    "demo": "node scripts/make-demo.ts",
    "plugin:new": "node scripts/plugin-new.ts",
    "plugin:check": "node scripts/plugin-check.ts",
    "dev": "node scripts/dev.ts",
    "build": "pnpm --filter @uncut/web build && pnpm --filter @uncut/server build && pnpm --filter @uncut/desktop build && node native/media/build-release.ts",
    "dist": "pnpm build && pnpm --filter @uncut/desktop dist",
    "dist:signed": "node apps/desktop/scripts/dist-signed.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@uncut/plugin-sdk": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "electron": "44.6.0",
    "puppeteer-core": "23.11.1",
    "typegpu": "0.12.6",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "@effect/platform-node-shared": "4.0.2"
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/blazejkustra/uncut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blazejkustra/uncut.git"
  },
  "bugs": {
    "url": "https://github.com/blazejkustra/uncut/issues"
  },
  "packageManager": "pnpm@8.13.1"
}
