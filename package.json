{
  "name": "uncut",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "wireframe": "node scripts/serve.mjs",
    "editor": "electron spikes/editor/main.cjs",
    "demo": "node spikes/editor/make-demo.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @uncut/web build && pnpm --filter @uncut/server build && pnpm --filter @uncut/desktop build && cargo build --release --manifest-path native/media/Cargo.toml",
    "dist": "pnpm build && pnpm --filter @uncut/desktop dist"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "electron": "44.6.0",
    "lucide": "0.460.0",
    "puppeteer-core": "23.11.1"
  },
  "pnpm": {
    "overrides": {
      "@effect/platform-node-shared": "4.0.2"
    }
  }
}
