{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uncut.dev/schema/module/0.json",
  "title": "Uncut module manifest (uncut.module.json)",
  "description": "One shape for every module. Built-in modules and community plugins use the same manifest.",
  "type": "object",
  "required": ["manifest", "id", "kind", "name", "version", "runtime"],
  "unevaluatedProperties": false,
  "properties": {
    "manifest": { "const": "uncut.module/0" },
    "apiVersion": {
      "type": "string",
      "pattern": "^uncut\\.module/[0-9]+$",
      "description": "The plugin protocol it was written for (D102): uncut.module/1 is the stdio contract in packages/plugin-sdk. Missing means uncut.module/1. A newer one than Uncut knows is refused."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$",
      "description": "Namespaced id used in project.json, e.g. transition.crossfade or argent.capture."
    },
    "kind": {
      "enum": ["transition", "move", "text-style", "component", "effect", "audio-processor", "analyzer", "generator", "capture-source", "importer", "pack"],
      "description": "pack (D103): a plugin that only adds data (contributes: text looks, components, check rules); nothing of it runs in Uncut's process or the renderer. importer (D280): a process plugin Uncut itself calls to bring a file into Media (Import from link); it has no agent tools."
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.+-]*)?$" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "icon": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*\\.svg$",
      "description": "D281: the plugin's icon, an .svg file at the top of its folder (icon.svg). Settings and the setup show its shape in the text colour; plain shapes only (no scripts, links, images, text or styles), at most 32 KB, with xmlns=\"http://www.w3.org/2000/svg\". Without one (or with one Uncut refuses) the plugin gets the generic icon."
    },
    "builtin": { "type": "boolean" },
    "runtime": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "description": "How the module runs. html modules render in the graphics layer; wasm runs sandboxed; native ships with the Rust core; process is an external program Uncut talks to.",
      "properties": {
        "type": { "enum": ["html", "wasm", "native", "process", "agent", "data"], "description": "data (D103): no program; the manifest's contributes is the whole plugin." },
        "entry": { "type": "string" },
        "command": { "type": "string", "minLength": 1, "description": "process: the program to start (a plugin folder needs one; built-in process modules run inside Uncut). \"node\" is Uncut's own Node runtime; a path with a slash is relative to the plugin's folder; a bare name is looked up on PATH." },
        "args": { "type": "array", "items": { "type": "string" }, "description": "process: its arguments. It starts in the plugin's folder, so relative paths are the folder's." },
        "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 1800, "description": "process: how long one tool call may take (default 120 s)." }
      }
    },
    "params": {
      "type": "object",
      "description": "JSON Schema for the module's props/params. The inspector builds its controls from it, and the agent reads it."
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "description": "What the module may touch. The user approves these on install. Nothing is allowed by default.",
      "items": {
        "enum": ["network", "project:read", "project:write", "media:read", "media:write", "process:spawn", "gpu", "microphone", "screen", "api-key"]
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binary": { "type": "string", "description": "An external program that must be on PATH." },
        "minVersion": { "type": "string" },
        "install": { "type": "string", "description": "The command onboarding shows in its inline terminal." },
        "platforms": { "type": "array", "items": { "enum": ["macos-arm64", "windows-x64", "linux-x64"] } }
      }
    },
    "agentTools": {
      "type": "array",
      "description": "Actions this module exposes to the agent as MCP tools.",
      "items": {
        "type": "object",
        "required": ["name", "description", "inputSchema"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string" },
          "inputSchema": { "type": "object" }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "description": "What a plugin adds to Uncut as data (D103), shown once the user allows the plugin. Every id is the plugin's id, a dot and a name (taste.extra.neon); an id a built-in has is refused.",
      "properties": {
        "skills": {
          "type": "array",
          "maxItems": 50,
          "description": "Skills (D232, issue #60), in the shape of a SKILL.md: name (lowercase words joined by -, what the user types after / in the composer), a description the agent reads in its system prompt to know when the skill fits, and the instructions it loads with skill_read (or that come with a message that names /name). Names are shared by every plugin: the first plugin with a name has it.",
          "items": {
            "type": "object",
            "required": ["name", "description", "instructions"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
              "title": { "type": "string", "minLength": 1, "maxLength": 80, "description": "What the Skills tab shows (default: the name)." },
              "description": { "type": "string", "minLength": 1, "maxLength": 300 },
              "instructions": { "type": "string", "minLength": 1, "maxLength": 20000 }
            }
          }
        },
        "looks": {
          "type": "array",
          "maxItems": 50,
          "description": "Text looks for the Text tab, the same look block as a built-in text style. A text added with one carries the whole look, so it keeps drawing when the plugin is removed.",
          "items": {
            "type": "object",
            "required": ["id", "name", "look"],
            "additionalProperties": false,
            "properties": { "id": { "$ref": "#/$defs/contributionId" }, "name": { "type": "string", "minLength": 1, "maxLength": 60 }, "description": { "type": "string", "maxLength": 300 }, "look": { "$ref": "#/$defs/look" } }
          }
        },
        "components": {
          "type": "array",
          "maxItems": 50,
          "description": "HTML/CSS templates for the Elements tab. {{name}} is replaced by the param's value, HTML-escaped; no scripts or event handlers. Drawn full canvas in the graphics sandbox (D78); adding one copies it into the project's graphics/ folder.",
          "items": {
            "type": "object",
            "required": ["id", "name", "template"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "name": { "type": "string", "minLength": 1, "maxLength": 60 },
              "description": { "type": "string", "maxLength": 300 },
              "params": { "type": "object", "description": "JSON Schema (type object) of the params; each property's default is what a new one gets." },
              "template": { "type": "string", "minLength": 1, "maxLength": 65536 },
              "css": { "type": "string", "maxLength": 65536 }
            }
          }
        },
        "filters": {
          "type": "array",
          "maxItems": 50,
          "description": "Colour looks for the Effects tab's filters (D136): numbers Uncut's colour maths draws (channel mixer, mono, adjust, curves, split toning, fade). A clip given one carries the whole look, so it keeps drawing when the plugin is removed.",
          "items": {
            "type": "object",
            "required": ["id", "name", "look"],
            "additionalProperties": false,
            "properties": { "id": { "$ref": "#/$defs/contributionId" }, "name": { "type": "string", "minLength": 1, "maxLength": 60 }, "description": { "type": "string", "maxLength": 300 }, "look": {"type": "object", "additionalProperties": false, "properties": {"mixer": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "number", "minimum": -4, "maximum": 4}, "description": "Channel mixer rows: r, g, b from r, g, b."}, "mono": {"type": "number", "minimum": 0, "maximum": 1}, "adjust": {"type": "object", "additionalProperties": false, "properties": {"exposure": {"type": "number", "minimum": -2, "maximum": 2, "default": 0, "description": "Exposure in stops"}, "contrast": {"type": "number", "minimum": -1, "maximum": 1, "default": 0, "description": "Contrast, -1 to 1 (0 = unchanged)"}, "saturation": {"type": "number", "minimum": -1, "maximum": 1, "default": 0, "description": "Saturation, -1 to 1 (0 = unchanged)"}, "temperature": {"type": "number", "minimum": -1, "maximum": 1, "default": 0, "description": "Temperature, -1 to 1 (0 = unchanged)"}, "tint": {"type": "number", "minimum": -1, "maximum": 1, "default": 0, "description": "Tint, -1 to 1 (0 = unchanged)"}, "highlights": {"type": "number", "minimum": -1, "maximum": 1, "default": 0, "description": "Highlights, -1 to 1 (0 = unchanged)"}, "shadows": {"type": "number", "minimum": -1, "maximum": 1, "default": 0, "description": "Shadows, -1 to 1 (0 = unchanged)"}, "vibrance": {"type": "number", "minimum": -1, "maximum": 1, "default": 0, "description": "Vibrance, -1 to 1 (0 = unchanged)"}}}, "curve": {"type": "array", "maxItems": 16, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}}, "red": {"type": "array", "maxItems": 16, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}}, "green": {"type": "array", "maxItems": 16, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}}, "blue": {"type": "array", "maxItems": 16, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}}, "shadowTint": {"type": "object", "required": ["color", "amount"], "additionalProperties": false, "properties": {"color": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}}, "amount": {"type": "number", "minimum": 0, "maximum": 1}}}, "highlightTint": {"type": "object", "required": ["color", "amount"], "additionalProperties": false, "properties": {"color": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}}, "amount": {"type": "number", "minimum": 0, "maximum": 1}}}, "fade": {"type": "number", "minimum": 0, "maximum": 0.5}}} }
          }
        },
        "shaders": {
          "type": "array",
          "maxItems": 50,
          "description": "Shader effects for the Effects tab (D213): a TypeGPU function in one of the plugin's .ts files (source, export) and the WGSL it resolves to (wgsl, written by pnpm plugin:check --write and checked against the source), with typed params. Drawn with WebGPU in the preview and the export; a clip given one carries the whole effect, so it keeps drawing when the plugin is removed.",
          "items": {
            "type": "object",
            "required": ["id", "name", "source", "export", "params", "wgsl"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "name": { "type": "string", "minLength": 1, "maxLength": 60 },
              "description": { "type": "string", "maxLength": 300 },
              "source": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.ts$", "description": "The .ts file at the plugin's top level that exports the TypeGPU function." },
              "export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$", "maxLength": 60 },
              "params": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": ["key", "label", "type", "default"],
                  "additionalProperties": false,
                  "properties": {
                    "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,30}$" },
                    "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                    "type": { "enum": ["number", "color", "bool"] },
                    "min": { "type": "number" },
                    "max": { "type": "number" },
                    "step": { "type": "number", "exclusiveMinimum": 0 },
                    "default": { "type": ["number", "string", "boolean"] }
                  }
                }
              },
              "wgsl": { "type": "string", "minLength": 1, "maxLength": 16384 }
            }
          }
        },
        "rules": {
          "type": "array",
          "maxItems": 50,
          "description": "Check rules for the Checks tab and the agent's project_check.",
          "items": {
            "type": "object",
            "required": ["id", "title", "rule"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "title": { "type": "string", "minLength": 1, "maxLength": 80 },
              "description": { "type": "string", "maxLength": 300 },
              "severity": { "enum": ["warn", "info"] },
              "hint": { "type": "string", "maxLength": 300 },
              "rule": {
                "oneOf": [
                  { "type": "object", "required": ["type", "max"], "additionalProperties": false, "properties": { "type": { "const": "max-words" }, "max": { "type": "integer", "minimum": 1 } }, "description": "At most this many words on screen at once (every text showing at a text's start)." },
                  { "type": "object", "required": ["type", "phrases"], "additionalProperties": false, "properties": { "type": { "const": "banned-phrases" }, "phrases": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 80 } } }, "description": "None of these words or phrases (whole words, any case)." },
                  { "type": "object", "required": ["type", "px"], "additionalProperties": false, "properties": { "type": { "const": "min-text-size" }, "px": { "type": "number", "exclusiveMinimum": 0 } }, "description": "Text at least this many px on a canvas whose shorter side is 1080." },
                  { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "end-card" }, "seconds": { "type": "number", "exclusiveMinimum": 0 } }, "description": "The video ends on a component (not a background) or a graphic, like an end card, shown for at least seconds (default 2)." },
                  { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "process" } }, "description": "A process plugin's own check: Uncut calls its check tool with the project and shows the findings it returns." }
                ]
              }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panel": { "enum": ["media", "capture", "text", "components", "transitions", "effects", "audio", "generate"] },
        "icon": { "type": "string", "description": "A lucide icon name." },
        "thumbnail": { "type": "string" }
      }
    }
  },
  "$defs": {
    "contributionId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*){2,}$", "description": "The plugin's id, a dot and a name." },
    "emLength": { "type": "number", "minimum": 0, "description": "A length as a share of the text's font size (em)." },
    "look": {
      "type": "object",
      "required": ["size", "weight", "x", "y"],
      "additionalProperties": false,
      "description": "How a text style looks (D80): what a text item with this preset gets when it's added or reset, and the fallbacks for the style fields it doesn't set. size, x, y and w are shares of the canvas (height for size and y, width for x and w); stroke, shadow and background lengths are shares of the font size (em), so they scale with it.",
      "properties": {
        "size": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "font": { "enum": ["sans", "mono", "DM Sans", "DM Mono"], "description": "sans, mono (the system's or the theme's), or a bundled family: DM Sans, DM Mono (D77)." },
        "tracking": { "type": "number", "description": "Letter spacing in em." },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string", "description": "A theme token (fg, mute, accent, bg) or a CSS colour." },
        "align": { "enum": ["left", "center", "right"] },
        "uppercase": { "type": "boolean" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0, "description": "The text box's width (share of the canvas width); none = as wide as its text." },
        "span": { "type": "boolean", "description": "The box spans the canvas between the safe margins (x and w ignored), as the Inspector's Centre does." },
        "stroke": {
          "type": "object",
          "required": ["width"],
          "additionalProperties": false,
          "properties": { "width": { "$ref": "#/$defs/emLength" }, "color": { "type": "string" } }
        },
        "shadow": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "blur": { "$ref": "#/$defs/emLength" }, "color": { "type": "string" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 } }
        },
        "legacyShadow": { "type": "boolean", "description": "Draws the soft shadow every text had before D80 (0 2px 18px, 45 % black) when the item sets no shadow, so older projects look the same." },
        "background": {
          "type": "object",
          "required": ["color"],
          "additionalProperties": false,
          "properties": {
            "color": { "type": "string" },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "padding": { "$ref": "#/$defs/emLength" },
            "radius": { "$ref": "#/$defs/emLength" },
            "wrap": { "enum": ["box", "lines"], "description": "box: one box around the text box (padding grows it); lines: a box behind each line, hugging the text." }
          }
        },
        "text": { "type": "string", "description": "Placeholder copy a new item gets." },
        "animation": {
          "type": "object",
          "additionalProperties": false,
          "description": "The in/out moves a new item gets, lengths in seconds.",
          "properties": { "in": { "$ref": "#/$defs/lookMove" }, "out": { "$ref": "#/$defs/lookMove" } }
        },
        "with": {
          "type": "array",
          "description": "Other text items added with it (e.g. a kicker above a title), each in its own look, dy = offset of its top from this one's (share of the canvas height).",
          "items": {
            "type": "object",
            "required": ["look", "text"],
            "additionalProperties": false,
            "properties": { "look": { "type": "string" }, "text": { "type": "string" }, "dy": { "type": "number" } }
          }
        }
      }
    },
    "lookMove": {
      "type": "object",
      "required": ["module", "seconds"],
      "additionalProperties": false,
      "properties": { "module": { "type": "string" }, "seconds": { "type": "number", "exclusiveMinimum": 0 }, "params": { "type": "object" } }
    },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "text-style" } } },
      "then": { "properties": { "look": { "$ref": "#/$defs/look" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "transition" } } },
      "then": {
        "properties": {
          "transition": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "minFrames": { "type": "integer", "minimum": 1 }, "maxFrames": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "component" } } },
      "then": {
        "properties": {
          "component": {
            "type": "object",
            "additionalProperties": false,
            "required": ["size"],
            "description": "How an html component is placed (D76). Sizes are canvas pixels on a canvas whose shorter side is 1080, scaled to the project's.",
            "properties": {
              "size": { "$ref": "#/$defs/size", "description": "The box a new one gets (centred)." },
              "fullFrame": { "type": "boolean", "description": "A new one fills the canvas instead." },
              "animated": { "type": "boolean", "description": "Its look changes from frame to frame (the export draws one picture per distinct look, capped)." },
              "defaults": { "type": "object", "description": "The props a new one gets; they validate against params." },
              "screens": {
                "type": "object",
                "description": "Device frames: per device, the frame's size and its screen rect (the clip under it), in that size's pixels.",
                "additionalProperties": {
                  "type": "object",
                  "required": ["size", "screen"],
                  "additionalProperties": false,
                  "properties": {
                    "size": { "$ref": "#/$defs/size" },
                    "screen": {
                      "type": "object",
                      "required": ["x", "y", "width", "height"],
                      "additionalProperties": false,
                      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "radius": { "type": "number", "minimum": 0 } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "analyzer" } } },
      "then": {
        "required": ["analyzer"],
        "properties": {
          "analyzer": {
            "type": "object",
            "required": ["inputs", "outputs", "backend"],
            "additionalProperties": false,
            "properties": {
              "inputs": { "type": "array", "minItems": 1, "items": { "enum": ["video", "audio", "image"] } },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["transcript", "shots", "motion", "stability", "loudness", "beats", "silence", "description"] }
              },
              "backend": { "enum": ["subscription-agent", "local-model", "api", "signal"] },
              "model": {
                "type": "object",
                "required": ["name", "sizeMb", "url"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "sizeMb": { "type": "number", "exclusiveMinimum": 0 },
                  "url": { "type": "string" },
                  "sha256": { "type": "string" }
                }
              }
            },
            "if": { "properties": { "backend": { "const": "local-model" } } },
            "then": { "required": ["model"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "generator" } } },
      "then": {
        "anyOf": [{ "required": ["generator"] }, { "required": ["generators"] }],
        "properties": {
          "generator": {
            "type": "object",
            "required": ["media", "provider"],
            "additionalProperties": false,
            "properties": {
              "media": { "enum": ["image", "video", "audio"] },
              "provider": { "type": "string" },
              "model": { "type": "string" }
            }
          },
          "generators": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "description": "A generator plugin's generators (#107, #108), each in the Generate tab and generate_media as generate.<id>. Uncut calls the plugin's tool (default generate) with {generator: id, prompt, seconds?, options}; the plugin sends its requests with uncut/fetch (the user's key for provider, added by Uncut, only to that provider's API) and saves its result with uncut/fetch's save. Needs the network and api-key capabilities.",
            "items": {
              "type": "object",
              "required": ["id", "name", "media", "provider", "billing", "price"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$", "maxLength": 60, "description": "Unique across plugins, the provider first: elevenlabs.voiceover." },
                "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                "media": { "enum": ["image", "video", "audio"] },
                "provider": { "enum": ["openai", "google", "elevenlabs"], "description": "Whose key it uses (Settings › Keys)." },
                "model": { "type": "string", "maxLength": 80 },
                "billing": { "type": "string", "maxLength": 120, "description": "How it's paid for, in a few words." },
                "tool": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,52}$", "description": "The tool Uncut calls to make it (default generate)." },
                "promptLabel": { "type": "string", "maxLength": 30, "description": "What the prompt is (Script)." },
                "placeholder": { "type": "string", "maxLength": 120 },
                "maxPrompt": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "seconds": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 }, "description": "Lengths to pick from, the first the default; a request may ask for any length between the shortest and the longest." },
                "options": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "required": ["id", "label", "type"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,31}$" },
                      "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                      "type": { "enum": ["choice", "toggle"] },
                      "choices": {
                        "type": "array",
                        "maxItems": 40,
                        "items": { "type": "object", "required": ["value", "label"], "additionalProperties": false, "properties": { "value": { "type": "string", "maxLength": 80 }, "label": { "type": "string", "maxLength": 80 } } }
                      },
                      "dynamic": { "type": "boolean", "description": "Its choices come from the plugin's choices tool ({generator, option}, with a grant); choices is then the fallback." },
                      "default": { "type": ["string", "boolean"] },
                      "description": { "type": "string", "maxLength": 200 }
                    }
                  }
                },
                "price": {
                  "type": "object",
                  "required": ["unit", "usd"],
                  "additionalProperties": false,
                  "description": "The estimate, in US dollars per character of the prompt or per second.",
                  "properties": {
                    "unit": { "enum": ["character", "second"] },
                    "usd": { "type": "number", "minimum": 0 },
                    "by": {
                      "type": "object",
                      "required": ["option", "usd"],
                      "additionalProperties": false,
                      "properties": { "option": { "type": "string" }, "usd": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "capture-source" } } },
      "then": {
        "required": ["capture"],
        "properties": {
          "capture": {
            "type": "object",
            "required": ["targets"],
            "additionalProperties": false,
            "properties": {
              "targets": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["ios-simulator", "ios-device", "android-emulator", "android-device", "chromium", "electron", "desktop-screen", "desktop-window", "microphone", "vega"] }
              },
              "flows": { "type": "boolean", "description": "Can save and replay recordings as flows (re-shoot)." },
              "agentDriven": { "type": "boolean", "description": "The agent can drive the target while it records." }
            }
          }
        }
      }
    }
  ]
}
