{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uncut.dev/schema/module/0.json",
  "title": "Uncut module manifest (uncut.module.json)",
  "description": "One shape for every module. Built-in modules and community plugins use the same manifest.",
  "type": "object",
  "required": ["manifest", "id", "kind", "name", "version", "runtime"],
  "unevaluatedProperties": false,
  "properties": {
    "manifest": { "const": "uncut.module/0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$",
      "description": "Namespaced id used in project.json, e.g. transition.crossfade or argent.capture."
    },
    "kind": {
      "enum": ["transition", "move", "text-style", "component", "effect", "audio-processor", "analyzer", "generator", "capture-source"]
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "builtin": { "type": "boolean" },
    "runtime": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "description": "How the module runs. html modules render in the graphics layer; wasm runs sandboxed; native ships with the Rust core; process is an external program Uncut talks to.",
      "properties": {
        "type": { "enum": ["html", "wasm", "native", "process", "agent"] },
        "entry": { "type": "string" },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "params": {
      "type": "object",
      "description": "JSON Schema for the module's props/params. The inspector builds its controls from it, and the agent reads it."
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "description": "What the module may touch. The user approves these on install. Nothing is allowed by default.",
      "items": {
        "enum": ["network", "project:read", "project:write", "media:read", "media:write", "process:spawn", "gpu", "microphone", "screen", "api-key"]
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binary": { "type": "string", "description": "An external program that must be on PATH." },
        "minVersion": { "type": "string" },
        "install": { "type": "string", "description": "The command onboarding shows in its inline terminal." },
        "platforms": { "type": "array", "items": { "enum": ["macos-arm64", "windows-x64", "linux-x64"] } }
      }
    },
    "agentTools": {
      "type": "array",
      "description": "Actions this module exposes to the agent as MCP tools.",
      "items": {
        "type": "object",
        "required": ["name", "description", "inputSchema"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string" },
          "inputSchema": { "type": "object" }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panel": { "enum": ["media", "capture", "text", "components", "transitions", "audio", "generate"] },
        "icon": { "type": "string", "description": "A lucide icon name." },
        "thumbnail": { "type": "string" }
      }
    }
  },
  "$defs": {
    "emLength": { "type": "number", "minimum": 0, "description": "A length as a share of the text's font size (em)." },
    "look": {
      "type": "object",
      "required": ["size", "weight", "x", "y"],
      "additionalProperties": false,
      "description": "How a text style looks (D80): what a text item with this preset gets when it's added or reset, and the fallbacks for the style fields it doesn't set. size, x, y and w are shares of the canvas (height for size and y, width for x and w); stroke, shadow and background lengths are shares of the font size (em), so they scale with it.",
      "properties": {
        "size": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "font": { "enum": ["sans", "mono", "DM Sans", "DM Mono"], "description": "sans, mono (the system's or the theme's), or a bundled family: DM Sans, DM Mono (D77)." },
        "tracking": { "type": "number", "description": "Letter spacing in em." },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string", "description": "A theme token (fg, mute, accent, bg) or a CSS colour." },
        "align": { "enum": ["left", "center", "right"] },
        "uppercase": { "type": "boolean" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0, "description": "The text box's width (share of the canvas width); none = as wide as its text." },
        "span": { "type": "boolean", "description": "The box spans the canvas between the safe margins (x and w ignored), as the Inspector's Centre does." },
        "stroke": {
          "type": "object",
          "required": ["width"],
          "additionalProperties": false,
          "properties": { "width": { "$ref": "#/$defs/emLength" }, "color": { "type": "string" } }
        },
        "shadow": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "blur": { "$ref": "#/$defs/emLength" }, "color": { "type": "string" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 } }
        },
        "legacyShadow": { "type": "boolean", "description": "Draws the soft shadow every text had before D80 (0 2px 18px, 45 % black) when the item sets no shadow, so older projects look the same." },
        "background": {
          "type": "object",
          "required": ["color"],
          "additionalProperties": false,
          "properties": {
            "color": { "type": "string" },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "padding": { "$ref": "#/$defs/emLength" },
            "radius": { "$ref": "#/$defs/emLength" },
            "wrap": { "enum": ["box", "lines"], "description": "box: one box around the text box (padding grows it); lines: a box behind each line, hugging the text." }
          }
        },
        "text": { "type": "string", "description": "Placeholder copy a new item gets." },
        "animation": {
          "type": "object",
          "additionalProperties": false,
          "description": "The in/out moves a new item gets, lengths in seconds.",
          "properties": { "in": { "$ref": "#/$defs/lookMove" }, "out": { "$ref": "#/$defs/lookMove" } }
        },
        "with": {
          "type": "array",
          "description": "Other text items added with it (e.g. a kicker above a title), each in its own look, dy = offset of its top from this one's (share of the canvas height).",
          "items": {
            "type": "object",
            "required": ["look", "text"],
            "additionalProperties": false,
            "properties": { "look": { "type": "string" }, "text": { "type": "string" }, "dy": { "type": "number" } }
          }
        }
      }
    },
    "lookMove": {
      "type": "object",
      "required": ["module", "seconds"],
      "additionalProperties": false,
      "properties": { "module": { "type": "string" }, "seconds": { "type": "number", "exclusiveMinimum": 0 }, "params": { "type": "object" } }
    },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "text-style" } } },
      "then": { "properties": { "look": { "$ref": "#/$defs/look" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "transition" } } },
      "then": {
        "properties": {
          "transition": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "minFrames": { "type": "integer", "minimum": 1 }, "maxFrames": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "component" } } },
      "then": {
        "properties": {
          "component": {
            "type": "object",
            "additionalProperties": false,
            "required": ["size"],
            "description": "How an html component is placed (D76). Sizes are canvas pixels on a canvas whose shorter side is 1080, scaled to the project's.",
            "properties": {
              "size": { "$ref": "#/$defs/size", "description": "The box a new one gets (centred)." },
              "fullFrame": { "type": "boolean", "description": "A new one fills the canvas instead." },
              "animated": { "type": "boolean", "description": "Its look changes from frame to frame (the export draws one picture per distinct look, capped)." },
              "defaults": { "type": "object", "description": "The props a new one gets; they validate against params." },
              "screens": {
                "type": "object",
                "description": "Device frames: per device, the frame's size and its screen rect (the clip under it), in that size's pixels.",
                "additionalProperties": {
                  "type": "object",
                  "required": ["size", "screen"],
                  "additionalProperties": false,
                  "properties": {
                    "size": { "$ref": "#/$defs/size" },
                    "screen": {
                      "type": "object",
                      "required": ["x", "y", "width", "height"],
                      "additionalProperties": false,
                      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "radius": { "type": "number", "minimum": 0 } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "analyzer" } } },
      "then": {
        "required": ["analyzer"],
        "properties": {
          "analyzer": {
            "type": "object",
            "required": ["inputs", "outputs", "backend"],
            "additionalProperties": false,
            "properties": {
              "inputs": { "type": "array", "minItems": 1, "items": { "enum": ["video", "audio", "image"] } },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["transcript", "shots", "motion", "stability", "loudness", "beats", "silence", "description"] }
              },
              "backend": { "enum": ["subscription-agent", "local-model", "api", "signal"] },
              "model": {
                "type": "object",
                "required": ["name", "sizeMb", "url"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "sizeMb": { "type": "number", "exclusiveMinimum": 0 },
                  "url": { "type": "string" },
                  "sha256": { "type": "string" }
                }
              }
            },
            "if": { "properties": { "backend": { "const": "local-model" } } },
            "then": { "required": ["model"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "generator" } } },
      "then": {
        "required": ["generator"],
        "properties": {
          "generator": {
            "type": "object",
            "required": ["media", "provider"],
            "additionalProperties": false,
            "properties": {
              "media": { "enum": ["image", "video", "audio"] },
              "provider": { "type": "string" },
              "model": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "capture-source" } } },
      "then": {
        "required": ["capture"],
        "properties": {
          "capture": {
            "type": "object",
            "required": ["targets"],
            "additionalProperties": false,
            "properties": {
              "targets": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["ios-simulator", "ios-device", "android-emulator", "android-device", "chromium", "electron", "desktop-screen", "desktop-window", "microphone", "vega"] }
              },
              "flows": { "type": "boolean", "description": "Can save and replay recordings as flows (re-shoot)." },
              "agentDriven": { "type": "boolean", "description": "The agent can drive the target while it records." }
            }
          }
        }
      }
    }
  ]
}
