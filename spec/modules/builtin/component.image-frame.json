{
  "manifest": "uncut.module/0",
  "id": "component.image-frame",
  "kind": "component",
  "name": "Image frame",
  "description": "An image in a rounded frame with an optional border and shadow.",
  "version": "0.1.0",
  "author": "Uncut",
  "license": "MIT",
  "builtin": true,
  "runtime": {
    "type": "html"
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "image": {
        "type": "object",
        "required": [
          "media"
        ],
        "additionalProperties": false,
        "properties": {
          "media": {
            "type": "string"
          }
        },
        "x-group": "Content",
        "description": "An image media item (PNG, JPEG, WebP, GIF, BMP or SVG)."
      },
      "fit": {
        "enum": [
          "cover",
          "contain"
        ],
        "x-group": "Layout",
        "description": "Fill the frame (cropped) or show the whole image."
      },
      "radius": {
        "type": "number",
        "minimum": 0,
        "maximum": 400,
        "x-unit": "px",
        "x-group": "Style",
        "description": "Corner radius."
      },
      "border": {
        "type": "string",
        "minLength": 1,
        "x-control": "color",
        "x-group": "Style",
        "description": "The border's colour."
      },
      "borderWidth": {
        "type": "number",
        "minimum": 0,
        "maximum": 60,
        "x-unit": "px",
        "x-group": "Style",
        "description": "The border's width."
      },
      "shadow": {
        "type": "boolean",
        "x-group": "Style",
        "description": "A soft drop shadow."
      }
    }
  },
  "component": {
    "size": {
      "width": 800,
      "height": 500
    },
    "defaults": {
      "fit": "cover",
      "radius": 24,
      "border": "#FFFFFF",
      "borderWidth": 0,
      "shadow": true
    }
  },
  "ui": {
    "panel": "components",
    "icon": "image"
  }
}
