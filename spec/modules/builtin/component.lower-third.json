{
  "manifest": "uncut.module/0",
  "id": "component.lower-third",
  "kind": "component",
  "name": "Lower third",
  "description": "A name and a title on a panel with an accent bar; it slides in over its first half second.",
  "version": "0.1.0",
  "author": "Uncut",
  "license": "MIT",
  "builtin": true,
  "runtime": {
    "type": "html"
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 120,
        "x-group": "Content",
        "description": "The big line."
      },
      "title": {
        "type": "string",
        "maxLength": 160,
        "x-group": "Content",
        "description": "The small line under it."
      },
      "accent": {
        "type": "string",
        "minLength": 1,
        "x-control": "color",
        "x-group": "Style",
        "description": "The bar's colour."
      },
      "background": {
        "type": "string",
        "minLength": 1,
        "x-control": "color",
        "x-group": "Style",
        "description": "The panel's colour."
      },
      "slide": {
        "type": "number",
        "minimum": 0,
        "maximum": 3,
        "x-unit": "s",
        "x-group": "Motion",
        "description": "How long the slide in takes."
      }
    }
  },
  "component": {
    "size": {
      "width": 900,
      "height": 200
    },
    "animated": true,
    "defaults": {
      "name": "Jane Doe",
      "title": "Product designer",
      "accent": "accent",
      "background": "#0A0A0BCC",
      "slide": 0.5
    }
  },
  "ui": {
    "panel": "components",
    "icon": "panel-bottom"
  }
}
