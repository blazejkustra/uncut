{
  "manifest": "uncut.module/0",
  "id": "component.follow",
  "kind": "component",
  "name": "Follow handle",
  "description": "Your handle on a platform, with a generic glyph for the kind of platform (no logos): the glyph pops, the pill opens, the handle slides in.",
  "version": "0.1.0",
  "author": "Uncut",
  "license": "MIT",
  "builtin": true,
  "runtime": {
    "type": "html"
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "handle": {
        "type": "string",
        "maxLength": 60,
        "x-group": "Content",
        "description": "The handle or address."
      },
      "label": {
        "type": "string",
        "maxLength": 40,
        "x-group": "Content",
        "description": "A small line above it (\"Follow\", \"Find me on\"); empty = none."
      },
      "platform": {
        "enum": [
          "video",
          "photos",
          "shorts",
          "social",
          "pro",
          "live",
          "web",
          "mail",
          "podcast"
        ],
        "x-group": "Content",
        "description": "Which glyph: video (play), photos (camera), shorts (note), social (@), pro (briefcase), live (broadcast), web (globe), mail, podcast (microphone)."
      },
      "style": {
        "enum": [
          "pill",
          "solid",
          "minimal"
        ],
        "x-group": "Style",
        "description": "A white pill, a pill in the colour, or just the glyph and words."
      },
      "color": {
        "type": "string",
        "minLength": 1,
        "x-control": "color",
        "x-group": "Style",
        "description": "The glyph's circle (or the solid pill); empty = the platform's tint."
      },
      "background": {
        "type": "string",
        "minLength": 1,
        "x-control": "color",
        "x-group": "Style",
        "description": "The pill's colour (pill style)."
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "x-control": "color",
        "x-group": "Style",
        "description": "The words' colour (pill style)."
      }
    }
  },
  "component": {
    "size": {
      "width": 680,
      "height": 140
    },
    "animated": true,
    "defaults": {
      "handle": "@yourname",
      "label": "Follow",
      "platform": "video",
      "style": "pill"
    }
  },
  "ui": {
    "panel": "components",
    "icon": "at-sign"
  }
}
