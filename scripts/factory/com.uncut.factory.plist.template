<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.uncut.factory</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PNPM_PATH__</string>
    <string>factory:run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__HOME__/.uncut-factory/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.uncut-factory/launchd.err.log</string>
</dict>
</plist>
