.DS_Store
.claude/
node_modules/
*.uncut/.cache/
test-output/

# Prose stays private (planning notes, specs), never committed; only the root README and CONTRIBUTING
# and GitHub's pull request template (D253) are published
planning/
*.md
!/README.md
!/CONTRIBUTING.md
!/.github/PULL_REQUEST_TEMPLATE.md
fixtures/
*.mp4
*.MP4
*.mov
*.MOV

# Build outputs
dist/
apps/*/dist/
# pnpm dist:signed's notarized DMGs (D247).
release/
native/media/target/
# D258: the plugins the desktop build lays out for electron-builder.
apps/desktop/stage/

# Finder aliases (one held a home path)
* alias

# wrangler pages dev (site/DEPLOY.txt) state
.wrangler/

# The website (site/, Next.js): build output, and the blog's posts are published Markdown (they are
# the site's content), so they're the one exception to *.md above.
site/.next/
site/out/
site/next-env.d.ts
!/site/content/blog/*.md

# Blog drafts (site/content/drafts/<slug>.md): reviewed on the preview branch, never committed.
site/content/drafts/
