      "interval": "1d",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Export duration p50 / p95",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "quantile_over_time(0.5, {service_name=\"uncut\"} | event_name=\"export:complete\" | unwrap duration_ms [1h]) by (service_name)",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {service_name=\"uncut\"} | event_name=\"export:complete\" | unwrap duration_ms [1h]) by (service_name)",
          "legendFormat": "p95"
        }
      ],
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "spanNulls": true,
            "showPoints": "always"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Agent turns per day",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
