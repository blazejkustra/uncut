      "type": "timeseries",
      "title": "Failures per day by event and code",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "sum by (event_name, code) (count_over_time({service_name=\"uncut\"} | event_name=~\".+:fail\" [1d]))",
          "legendFormat": "{{event_name}} {{code}}",
          "step": "1d"
        }
