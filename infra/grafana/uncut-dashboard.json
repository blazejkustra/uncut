          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "sum by (event_name, code) (count_over_time({service_name=\"uncut\"} | event_name=~\".+:fail\" [$__range]))",
          "legendFormat": ""
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
