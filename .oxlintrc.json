{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["assets/**"],
  "rules": {
    // House idioms: `(stop(), close())` and `a && b()` as statements, control characters in the
    // sanitizers' regexes, a spread that snapshots a map before the loop deletes from it, and a
    // preallocated `new Array(n)` filled by index.
    "no-unused-expressions": "off",
    "no-control-regex": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-new-array": "off",
    "no-unused-vars": ["warn", { "ignoreRestSiblings": true, "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }]
  },
  "overrides": [
    {
      // Wrapped into assets/graphic-libs/ui.js, where its top-level functions are the library's API.
      "files": ["apps/web/src/uiparts/runtime.ts"],
      "rules": { "no-unused-vars": "off" }
    }
  ]
}
